#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Wiki Garden Tool capture — turn a raw, one-off script into a reusable,
parameterized command-line tool, STAGED under <store>/tool-proposals/ for the
gate. It is never installed onto PATH until accepted.

The LLM only generalizes the script and returns JSON; this script writes the
staged files deterministically. Backend/env are the same as the other runners.

Runtime + name prefix come from config (~/.config/wiki-garden/config):
  tool_prefix  = gt-      (namespaces every tool; tab-completable)
  tool_runtime = bash     (default runtime; --runtime overrides)

Usage:
  garden-tool --from script.sh [--name ecs-status] [--runtime uv]
  some-command | garden-tool --name ecs-status        # read raw script from stdin
  garden-tool --from s.sh --dry-run                    # print proposal, write nothing
  garden-tool --from s.sh --plan-file gen.json         # stage a given generalization
"""
from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _garden
from _garden import call_llm, die, log, parse_json, tool_settings

PROMPT_FILE = HERE.parent / "prompts" / "tool-generalizer.md"


def read_source(args) -> str:
    if args.from_:
        return Path(args.from_).read_text()
    if not sys.stdin.isatty():
        data = sys.stdin.read()
        if data.strip():
            return data
    die("no source script: pass --from <path> or pipe the script on stdin")


def tool_md(prop: dict, full_name: str) -> str:
    args_lines = "\n".join(
        f"  - {a.get('name','')}: {a.get('desc','')}"
        f"{' (required)' if a.get('required') else ''}"
        f"{(' [default: ' + str(a['default']) + ']') if a.get('default') else ''}"
        for a in prop.get("args", [])) or "  (none)"
    deps = ", ".join(prop.get("deps", [])) or "none"
    return (
        f"---\n"
        f"name: {full_name}\n"
        f"description: {prop.get('description','').strip()}\n"
        f"runtime: {prop.get('runtime','')}\n"
        f"usage: {prop.get('usage','').strip()}\n"
        f"deps: [{', '.join(prop.get('deps', []))}]\n"
        f"---\n"
        f"# {full_name}\n\n"
        f"{prop.get('description','').strip()}\n\n"
        f"## Usage\n```\n{prop.get('usage','').strip()}\n```\n\n"
        f"## Args\n{args_lines}\n\n"
        f"## Requires\n{deps}\n\n"
        f"## Safety\n{prop.get('safety_notes','').strip() or 'No notable side effects.'}\n")


def purpose_md(prop: dict, source_note: str) -> str:
    return (f"pattern: {prop.get('pattern','') or '(manual capture)'}\n"
            f"proposed: {date.today().isoformat()}\n"
            f"gate: human=pending review=pending\n"
            f"source: {source_note}\n"
            f"rationale: {prop.get('report','').strip()}\n")


def stage(store: Path, prop: dict, prefix: str, source_note: str, dry_run: bool) -> str | None:
    if prop.get("decision") != "tool":
        return None
    name = prop.get("name") or "unnamed"
    full = f"{prefix}{name}"
    ts = datetime.now().strftime("%Y-%m-%dT%H-%M")
    pdir = store / "tool-proposals" / f"{ts}_{name}"
    if dry_run:
        return str(pdir)
    pdir.mkdir(parents=True, exist_ok=True)
    exe = pdir / full
    exe.write_text(prop["script"].rstrip() + "\n")
    exe.chmod(exe.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    (pdir / "TOOL.md").write_text(tool_md(prop, full))
    (pdir / "PURPOSE.md").write_text(purpose_md(prop, source_note))
    (pdir / "proposal.json").write_text(json.dumps(prop, indent=2))
    return str(pdir)


def main() -> int:
    ap = argparse.ArgumentParser(description="Wiki Garden tool capture")
    ap.add_argument("--from", dest="from_", help="path to the raw script (else stdin)")
    ap.add_argument("--name", help="suggested tool name (kebab, no prefix)")
    ap.add_argument("--runtime", help="bash | uv | node (default from config)")
    ap.add_argument("--dry-run", action="store_true", help="print proposal, write nothing")
    ap.add_argument("--plan-file", help="stage a pre-made generalization JSON; skip the LLM")
    ap.add_argument("--backend", default=os.environ.get("WIKIGARDEN_LLM", "claude"))
    ap.add_argument("--model", default=os.environ.get("WIKIGARDEN_LLM_MODEL"))
    args = ap.parse_args()

    store = _garden.resolve_store(HERE)
    (store / "tool-proposals").mkdir(parents=True, exist_ok=True)
    prefix, default_runtime = tool_settings()
    runtime = args.runtime or default_runtime
    log(f"store: {store}  prefix: {prefix}  runtime: {runtime}")

    source_note = args.from_ or "stdin"
    if args.plan_file:
        prop = json.loads(Path(args.plan_file).read_text())
    else:
        raw = read_source(args)
        system = PROMPT_FILE.read_text()
        user = (f"TARGET RUNTIME: {runtime}\n"
                f"SUGGESTED NAME: {args.name or '(you choose)'}\n\n"
                f"RAW SCRIPT:\n{raw}\n\nReturn the JSON.")
        prop = parse_json(call_llm(system, user, args.backend, args.model))
        prop.setdefault("runtime", runtime)

    staged = stage(store, prop, prefix, source_note, args.dry_run)

    print(json.dumps({
        "dry_run": args.dry_run,
        "decision": prop.get("decision"),
        "tool": (prefix + prop["name"]) if prop.get("name") else None,
        "runtime": prop.get("runtime"),
        "staged_at": staged,
        "report": prop.get("report", ""),
    }, indent=2))
    if prop.get("decision") == "tool" and not args.dry_run:
        log(f"staged tool at {staged} — review the code & gate before installing")
    return 0


if __name__ == "__main__":
    sys.exit(main())
