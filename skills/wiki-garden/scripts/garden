#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.12"]
# ///
"""Zero-install launcher for the `garden` CLI, shipped inside the skill.

When the skill is installed on its own (e.g. `npx skills add phin-tech/wiki-garden`)
`garden` is not on PATH, but this script is — run it with `uv run` and it pulls
`typer` per the header above, then hands off to the sibling `wiki_garden` package:

    uv run <skill-dir>/scripts/garden home

For a first-class `garden` on PATH instead, install the package as a uv tool:

    uv tool install "git+https://github.com/phin-tech/wiki-garden.git#subdirectory=skills/wiki-garden"
"""
import sys
from pathlib import Path

# The skill dir (parent of scripts/) holds the wiki_garden/ package; put it on the
# path so `import wiki_garden` resolves whether we were invoked directly or via a
# PATH symlink (resolve() follows the link to the real file in the checkout/skill).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from wiki_garden.cli import main

main()
