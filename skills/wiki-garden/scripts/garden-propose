#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Wiki Garden Skill Proposer — standalone, model-agnostic runner.

Reads the wiki + existing skills + skill-impact ledger and asks an LLM for ONE
atomic skill proposal (or no_change). The proposal is STAGED under
<store>/proposals/ — it is never activated into <store>/skills/. Gating (Phase 4)
promotes or rejects it. Backend/env are identical to garden-maintain.

Usage:
  garden-propose                  # call LLM, stage a proposal
  garden-propose --dry-run        # call LLM, print proposal, write nothing
  garden-propose --plan-file p.json    # stage a given proposal (tests stager)
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))  # import _garden even when invoked via a PATH symlink
import _garden
from _garden import call_llm, log, parse_json

PROMPT_FILE = HERE.parent / "prompts" / "skill-proposer.md"


def gather_context(store: Path) -> str:
    pdir = store / "wiki" / "patterns"
    patterns = "\n\n".join(
        f"### PATTERN FILE: {f.name}\n{f.read_text()}"
        for f in sorted(pdir.glob("*.md"))) if pdir.exists() else ""
    patterns = patterns or "(no patterns yet)"

    sdir = store / "skills"
    skills = []
    if sdir.exists():
        for d in sorted(p for p in sdir.iterdir() if p.is_dir()):
            sm = d / "SKILL.md"
            head = sm.read_text()[:400] if sm.exists() else "(no SKILL.md)"
            skills.append(f"- {d.name}:\n{head}")
    skills_ctx = "\n".join(skills) or "(no skills yet)"

    ledger = store / "wiki" / "skill-impact.jsonl"
    ledger_ctx = ledger.read_text().strip() if ledger.exists() else ""
    ledger_ctx = ledger_ctx or "(no prior decisions)"

    return (f"CURRENT WIKI PATTERNS:\n{patterns}\n\n"
            f"EXISTING SKILLS:\n{skills_ctx}\n\n"
            f"SKILL-IMPACT LEDGER (past decisions — do not re-propose rejected):\n"
            f"{ledger_ctx}")


def purpose_md(prop: dict) -> str:
    return (f"pattern: {prop.get('pattern','')}\n"
            f"proposed: {date.today().isoformat()}\n"
            f"gate: human=pending retro=pending\n"
            f"rationale: {prop.get('rationale','').strip()}\n")


def stage(store: Path, prop: dict, dry_run: bool) -> str | None:
    if prop.get("decision") != "propose":
        return None
    name = prop.get("skill_name") or "unnamed"
    ts = datetime.now().strftime("%Y-%m-%dT%H-%M")
    pdir = store / "proposals" / f"{ts}_{name}"
    if dry_run:
        return str(pdir)
    pdir.mkdir(parents=True, exist_ok=True)
    (pdir / "SKILL.md").write_text(prop["skill_md"].rstrip() + "\n")
    (pdir / "PURPOSE.md").write_text(purpose_md(prop))
    (pdir / "proposal.json").write_text(json.dumps(prop, indent=2))
    return str(pdir)


def main() -> int:
    ap = argparse.ArgumentParser(description="Wiki Garden standalone skill proposer")
    ap.add_argument("--dry-run", action="store_true", help="print proposal, write nothing")
    ap.add_argument("--plan-file", help="stage a pre-made proposal JSON; skip the LLM")
    ap.add_argument("--backend", default=os.environ.get("WIKIGARDEN_LLM", "claude"))
    ap.add_argument("--model", default=os.environ.get("WIKIGARDEN_LLM_MODEL"))
    args = ap.parse_args()

    store = _garden.resolve_store(HERE)
    (store / "proposals").mkdir(parents=True, exist_ok=True)
    log(f"store: {store}")

    if args.plan_file:
        prop = json.loads(Path(args.plan_file).read_text())
    else:
        system = PROMPT_FILE.read_text()
        user = gather_context(store) + f"\n\nToday is {date.today().isoformat()}. Return the JSON proposal."
        prop = parse_json(call_llm(system, user, args.backend, args.model))

    staged = stage(store, prop, args.dry_run)

    print(json.dumps({
        "dry_run": args.dry_run,
        "decision": prop.get("decision"),
        "skill_name": prop.get("skill_name"),
        "pattern": prop.get("pattern"),
        "staged_at": staged,
        "report": prop.get("report", ""),
    }, indent=2))
    if prop.get("decision") == "propose" and not args.dry_run:
        log(f"staged proposal at {staged} — review & gate before activating (Phase 4)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
