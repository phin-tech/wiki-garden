#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Wiki Garden Tool Gate — review and accept/reject staged tool proposals.

Tools are executable, so gating is stricter than for skills: a human MUST read
the code, and a static safety review (an LLM judge that never runs the tool) is
advisory on top. Accepting promotes the tool into <store>/tools/ and symlinks its
<prefix><name> executable onto ~/.local/bin (PATH). Every decision is recorded to
wiki/tool-impact.jsonl.

Commands:
  garden-tool-gate list
  garden-tool-gate show   <name>            # manifest + FULL source (read it!)
  garden-tool-gate review <name>            # static safety review, print verdict
  garden-tool-gate accept <name> [--note ..] [--no-install]
  garden-tool-gate reject <name>  --note ..
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _garden
from _garden import call_llm, die, log, parse_json

REVIEW_PROMPT = HERE.parent / "prompts" / "tool-review.md"
META = {"TOOL.md", "PURPOSE.md", "proposal.json"}


def store() -> Path:
    return _garden.resolve_store(HERE)


def proposal_dir(st: Path, name: str) -> Path:
    props = st / "tool-proposals"
    exact = props / name
    if exact.is_dir():
        return exact
    hits = [d for d in props.glob("*") if d.is_dir() and not d.name.startswith(".")
            and d.name.endswith(f"_{name}")]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no staged tool matching '{name}' (try: garden-tool-gate list)")
    die(f"'{name}' is ambiguous: {', '.join(d.name for d in hits)}")


def executable_of(pdir: Path) -> Path:
    exes = [f for f in pdir.iterdir() if f.is_file() and f.name not in META]
    if not exes:
        die(f"no executable found in {pdir.name}")
    return exes[0]


def load_proposal(pdir: Path) -> dict:
    return json.loads((pdir / "proposal.json").read_text())


def run_review(st: Path, pdir: Path, backend: str, model: str | None) -> dict:
    exe = executable_of(pdir)
    manifest = (pdir / "TOOL.md").read_text() if (pdir / "TOOL.md").exists() else ""
    user = (f"TOOL MANIFEST (TOOL.md):\n{manifest}\n\n"
            f"TOOL SOURCE ({exe.name}):\n{exe.read_text()}\n\nReturn the JSON review.")
    try:
        out = parse_json(call_llm(REVIEW_PROMPT.read_text(), user, backend, model))
    except SystemExit:
        raise
    except Exception as e:
        return {"verdict": "skipped", "findings": [], "summary": f"review error: {e}"}
    resdir = st / "eval" / "results"
    resdir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%dT%H-%M")
    (resdir / f"{ts}_{pdir.name}_toolreview.json").write_text(json.dumps(out, indent=2))
    return out


def record(st: Path, prop: dict, human: str, review: str, decision: str, note: str):
    rec = {"date": date.today().isoformat(), "tool": prop.get("name", ""),
           "runtime": prop.get("runtime", ""), "human": human, "review": review,
           "decision": decision, "note": note}
    ledger = st / "wiki" / "tool-impact.jsonl"
    ledger.parent.mkdir(parents=True, exist_ok=True)
    with ledger.open("a") as fh:
        fh.write(json.dumps(rec) + "\n")


def update_purpose_gate(pdir: Path, human: str, review: str):
    pf = pdir / "PURPOSE.md"
    if not pf.exists():
        return
    lines = [f"gate: human={human} review={review}" if ln.startswith("gate:") else ln
             for ln in pf.read_text().splitlines()]
    pf.write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------- commands

def cmd_list(st: Path, args):
    props = sorted(d for d in (st / "tool-proposals").glob("*")
                   if d.is_dir() and not d.name.startswith(".")) if (st / "tool-proposals").exists() else []
    if not props:
        print("(no staged tools)")
        return
    for d in props:
        prop = load_proposal(d)
        print(f"- {d.name}\n    tool: {executable_of(d).name}  runtime: {prop.get('runtime')}")
        print(f"    {prop.get('description','').strip()[:100]}")


def cmd_show(st: Path, args):
    pdir = proposal_dir(st, args.name)
    exe = executable_of(pdir)
    print(f"=== {pdir.name} ===\n")
    print("--- PURPOSE.md ---"); print((pdir / "PURPOSE.md").read_text())
    print("--- TOOL.md ---"); print((pdir / "TOOL.md").read_text())
    print(f"--- SOURCE: {exe.name} (READ THIS before accepting) ---")
    print(exe.read_text())


def cmd_review(st: Path, args):
    print(json.dumps(run_review(st, proposal_dir(st, args.name), args.backend, args.model), indent=2))


def cmd_accept(st: Path, args):
    pdir = proposal_dir(st, args.name)
    prop = load_proposal(pdir)
    name = prop.get("name") or pdir.name.split("_", 1)[-1]
    exe = executable_of(pdir)

    review = run_review(st, pdir, args.backend, args.model)
    verdict = review.get("verdict", "skipped")
    if verdict == "unsafe":
        log(f"static review flagged UNSAFE: {review.get('summary','')} — accepting on human override")

    dest = st / "tools" / name
    if dest.exists():
        die(f"tools/{name} already exists — reject or edit instead")
    update_purpose_gate(pdir, "accepted", verdict)
    shutil.move(str(pdir), str(dest))
    record(st, prop, "accepted", verdict, "accepted", args.note or "")

    installed = ""
    dest_exe = dest / exe.name
    if not args.no_install:
        link = Path.home() / ".local" / "bin" / exe.name
        link.parent.mkdir(parents=True, exist_ok=True)
        if not link.exists():
            os.symlink(dest_exe, link)
            installed = str(link)
    cat = _garden.write_tools_catalog(st)  # refresh the discoverable catalog skill
    print(json.dumps({"decision": "accepted", "tool": exe.name, "review": verdict,
                      "activated_at": str(dest), "installed_at": installed or None,
                      "catalog_tools": cat["count"]}, indent=2))
    log(f"accepted {exe.name}: promoted to tools/{'; on PATH: ' + installed if installed else ''}")
    log(f"catalog refreshed — {cat['count']} tool(s): {', '.join(cat['names'])}")


def cmd_reject(st: Path, args):
    if not args.note:
        die("reject requires --note (why — recorded in tool-impact.jsonl)")
    pdir = proposal_dir(st, args.name)
    prop = load_proposal(pdir)
    review = run_review(st, pdir, args.backend, args.model) if args.review else {"verdict": "not-run"}
    record(st, prop, "rejected", review.get("verdict", "not-run"), "rejected", args.note)
    arch = st / "tool-proposals" / ".rejected"
    arch.mkdir(parents=True, exist_ok=True)
    shutil.move(str(pdir), str(arch / pdir.name))
    print(json.dumps({"decision": "rejected", "tool": prop.get("name"),
                      "note": args.note, "archived": str(arch / pdir.name)}, indent=2))
    log(f"rejected {prop.get('name')} — recorded in tool-impact.jsonl")


def main() -> int:
    ap = argparse.ArgumentParser(description="Wiki Garden tool gate")
    ap.add_argument("--backend", default=os.environ.get("WIKIGARDEN_LLM", "claude"))
    ap.add_argument("--model", default=os.environ.get("WIKIGARDEN_LLM_MODEL"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    for c in ("show", "review"):
        sub.add_parser(c).add_argument("name")
    acc = sub.add_parser("accept")
    acc.add_argument("name"); acc.add_argument("--note", default=""); acc.add_argument("--no-install", action="store_true")
    rej = sub.add_parser("reject")
    rej.add_argument("name"); rej.add_argument("--note", default=""); rej.add_argument("--review", action="store_true")
    args = ap.parse_args()

    st = store()
    log(f"store: {st}")
    {"list": cmd_list, "show": cmd_show, "review": cmd_review,
     "accept": cmd_accept, "reject": cmd_reject}[args.cmd](st, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
