#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Wiki Garden Gate — review, retro-eval, and accept/reject staged skill proposals.

Gating has two parts (per the design): retro-eval (an LLM judge over eval/stash/
past tasks — advisory, skipped when the stash is empty) and a human decision.
This CLI provides the deterministic mechanics; the human decision is supplied by
the caller (you, via /garden-gate). Every decision is recorded to
wiki/skill-impact.jsonl so rejected ideas are never re-proposed.

Commands:
  garden-gate list                       # staged proposals
  garden-gate show   <name>              # print a proposal (SKILL.md + PURPOSE.md)
  garden-gate retro  <name>              # run retro-eval, print + save verdict
  garden-gate accept <name> [--note ..] [--no-install]
  garden-gate reject <name>  --note ..
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _garden
from _garden import call_llm, die, log, parse_json

RETRO_PROMPT = HERE.parent / "prompts" / "retro-eval.md"


def store() -> Path:
    return _garden.resolve_store(HERE)


def proposal_dir(st: Path, name: str) -> Path:
    """Match a proposal by exact dir name or by trailing skill name."""
    proposals = st / "proposals"
    exact = proposals / name
    if exact.is_dir():
        return exact
    hits = [d for d in proposals.glob("*") if d.is_dir() and d.name.endswith(f"_{name}")]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no staged proposal matching '{name}' (try: garden-gate list)")
    die(f"'{name}' is ambiguous: {', '.join(d.name for d in hits)}")


def load_proposal(pdir: Path) -> dict:
    return json.loads((pdir / "proposal.json").read_text())


# ---------------------------------------------------------------- retro-eval

def run_retro(st: Path, pdir: Path, backend: str, model: str | None) -> dict:
    skill_md = (pdir / "SKILL.md").read_text()
    stash = sorted((st / "eval" / "stash").glob("*.md")) if (st / "eval" / "stash").exists() else []
    if not stash:
        return {"result": "skipped", "reason": "eval/stash is empty", "cases": []}

    system = RETRO_PROMPT.read_text()
    cases = []
    for task in stash:
        user = (f"PAST TASK:\n{task.read_text()}\n\n"
                f"CANDIDATE SKILL (SKILL.md):\n{skill_md}\n\n"
                f"Return the JSON verdict.")
        try:
            v = parse_json(call_llm(system, user, backend, model))
        except SystemExit:
            raise
        except Exception as e:  # keep going; a broken case shouldn't abort the gate
            v = {"verdict": "neutral", "applies": False, "why": f"eval error: {e}"}
        v["task"] = task.name
        cases.append(v)

    harmful = [c for c in cases if c.get("verdict") == "harmful"]
    result = "fail" if harmful else "pass"
    out = {"result": result, "harmful": len(harmful), "cases": cases}

    resdir = st / "eval" / "results"
    resdir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%dT%H-%M")
    (resdir / f"{ts}_{pdir.name}.json").write_text(json.dumps(out, indent=2))
    return out


# ---------------------------------------------------------------- ledger

def record(st: Path, prop: dict, human: str, retro: str, decision: str, note: str):
    rec = {
        "date": date.today().isoformat(),
        "proposal": prop.get("skill_name", ""),
        "pattern": prop.get("pattern", ""),
        "human": human,
        "retro": retro,
        "decision": decision,
        "note": note,
    }
    ledger = st / "wiki" / "skill-impact.jsonl"
    ledger.parent.mkdir(parents=True, exist_ok=True)
    with ledger.open("a") as fh:
        fh.write(json.dumps(rec) + "\n")


def update_purpose_gate(pdir: Path, human: str, retro: str):
    pf = pdir / "PURPOSE.md"
    if not pf.exists():
        return
    lines = []
    for ln in pf.read_text().splitlines():
        if ln.startswith("gate:"):
            lines.append(f"gate: human={human} retro={retro}")
        else:
            lines.append(ln)
    pf.write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------- commands

def cmd_list(st: Path, args):
    proposals = sorted((st / "proposals").glob("*")) if (st / "proposals").exists() else []
    proposals = [p for p in proposals if p.is_dir()]
    if not proposals:
        print("(no staged proposals)")
        return
    for d in proposals:
        prop = load_proposal(d)
        print(f"- {d.name}\n    skill: {prop.get('skill_name')}  pattern: {prop.get('pattern')}")
        print(f"    rationale: {prop.get('rationale','').strip()}")


def cmd_show(st: Path, args):
    pdir = proposal_dir(st, args.name)
    print(f"=== {pdir.name} ===\n")
    print("--- PURPOSE.md ---")
    print((pdir / "PURPOSE.md").read_text())
    print("--- SKILL.md ---")
    print((pdir / "SKILL.md").read_text())


def cmd_retro(st: Path, args):
    pdir = proposal_dir(st, args.name)
    out = run_retro(st, pdir, args.backend, args.model)
    print(json.dumps(out, indent=2))


def cmd_accept(st: Path, args):
    pdir = proposal_dir(st, args.name)
    prop = load_proposal(pdir)
    name = prop.get("skill_name") or pdir.name.split("_", 1)[-1]

    retro = run_retro(st, pdir, args.backend, args.model)
    retro_str = {"pass": "passed", "fail": "failed", "skipped": "skipped"}.get(retro["result"], retro["result"])
    if retro["result"] == "fail":
        log(f"retro-eval FAILED ({retro['harmful']} harmful) — accepting on human override")

    dest = st / "skills" / name
    if dest.exists():
        die(f"skills/{name} already exists — reject or edit instead")
    update_purpose_gate(pdir, "accepted", retro_str)
    shutil.move(str(pdir), str(dest))
    record(st, prop, "accepted", retro_str, "accepted", args.note or "")

    installed = ""
    if not args.no_install:
        link = Path.home() / ".claude" / "skills" / name
        link.parent.mkdir(parents=True, exist_ok=True)
        if not link.exists():
            os.symlink(dest, link)
            installed = f" and installed -> {link}"
    print(json.dumps({
        "decision": "accepted", "skill": name, "retro": retro_str,
        "activated_at": str(dest), "installed": bool(installed),
    }, indent=2))
    log(f"accepted {name}: promoted to skills/{installed}")


def cmd_reject(st: Path, args):
    if not args.note:
        die("reject requires --note (why — recorded so it is not re-proposed)")
    pdir = proposal_dir(st, args.name)
    prop = load_proposal(pdir)
    retro = run_retro(st, pdir, args.backend, args.model) if args.retro else {"result": "not-run"}
    record(st, prop, "rejected", retro["result"], "rejected", args.note)
    # archive the proposal out of the staging area
    arch = st / "proposals" / ".rejected"
    arch.mkdir(parents=True, exist_ok=True)
    shutil.move(str(pdir), str(arch / pdir.name))
    print(json.dumps({"decision": "rejected", "skill": prop.get("skill_name"),
                      "note": args.note, "archived": str(arch / pdir.name)}, indent=2))
    log(f"rejected {prop.get('skill_name')} — recorded in skill-impact.jsonl")


def main() -> int:
    ap = argparse.ArgumentParser(description="Wiki Garden gate")
    ap.add_argument("--backend", default=os.environ.get("WIKIGARDEN_LLM", "claude"))
    ap.add_argument("--model", default=os.environ.get("WIKIGARDEN_LLM_MODEL"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    for c in ("show", "retro"):
        sp = sub.add_parser(c); sp.add_argument("name")
    acc = sub.add_parser("accept")
    acc.add_argument("name"); acc.add_argument("--note", default="")
    acc.add_argument("--no-install", action="store_true")
    rej = sub.add_parser("reject")
    rej.add_argument("name"); rej.add_argument("--note", default="")
    rej.add_argument("--retro", action="store_true", help="also run retro-eval before rejecting")
    args = ap.parse_args()

    st = store()
    log(f"store: {st}")
    {"list": cmd_list, "show": cmd_show, "retro": cmd_retro,
     "accept": cmd_accept, "reject": cmd_reject}[args.cmd](st, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
