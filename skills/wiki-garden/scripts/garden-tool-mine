#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Wiki Garden Tool Miner — the ambient path for the tools layer (T4).

Scans unmined raw/ traces for recurring/reusable command-line operations and
stages them as tool proposals by piping each candidate through garden-tool (so
they get the same generalization, secret-stripping, config runtime/overlays, and
staging). Proposals then go through garden-tool-gate like any other. A cursor
(tools/.mined.log) makes it incremental; existing + rejected names are skipped.

Usage:
  garden-tool-mine                 # mine unmined traces, stage candidates
  garden-tool-mine --dry-run       # print candidates, stage nothing
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _garden
from _garden import call_llm, die, log, parse_json

PROMPT_FILE = HERE.parent / "prompts" / "tool-miner.md"


def unmined_traces(store: Path) -> list[str]:
    raw = store / "raw"
    cur = store / "tools" / ".mined.log"
    done = set(cur.read_text().split()) if cur.exists() else set()
    if not raw.exists():
        return []
    return sorted(f.name for f in raw.glob("*.md") if f.name not in done)


def known_names(store: Path) -> set[str]:
    names = set()
    for sub in ("tools", "tool-proposals"):
        d = store / sub
        if d.exists():
            for p in d.glob("*"):
                if p.is_dir() and not p.name.startswith("."):
                    names.add(p.name.split("_", 1)[-1] if sub == "tool-proposals" else p.name)
    ledger = store / "wiki" / "tool-impact.jsonl"
    if ledger.exists():
        for ln in ledger.read_text().splitlines():
            try:
                r = json.loads(ln)
                if r.get("decision") == "rejected":
                    names.add(r.get("tool", ""))
            except json.JSONDecodeError:
                pass
    return {n for n in names if n}


def main() -> int:
    ap = argparse.ArgumentParser(description="Wiki Garden tool miner")
    ap.add_argument("--dry-run", action="store_true", help="print candidates, stage nothing")
    ap.add_argument("--backend", default=os.environ.get("WIKIGARDEN_LLM", "claude"))
    ap.add_argument("--model", default=os.environ.get("WIKIGARDEN_LLM_MODEL"))
    args = ap.parse_args()

    store = _garden.resolve_store(HERE)
    log(f"store: {store}")
    traces = unmined_traces(store)
    if not traces:
        log("no new traces to mine")
        return 0
    log(f"mining {len(traces)} trace(s): {', '.join(traces)}")

    existing = known_names(store)
    blob = "\n\n".join(f"### TRACE: {t}\n{(store / 'raw' / t).read_text()}" for t in traces)
    user = (f"EXISTING TOOLS: {', '.join(sorted(existing)) or '(none)'}\n"
            f"REJECTED TOOLS: (see above, already merged into EXISTING)\n\n"
            f"RECENT TRACES:\n{blob}\n\nReturn the JSON.")
    try:
        result = parse_json(call_llm(PROMPT_FILE.read_text(), user, args.backend, args.model))
    except RuntimeError as e:
        die(str(e))

    candidates = [c for c in result.get("candidates", []) if c.get("name") not in existing]
    staged = []
    for c in candidates:
        name = c.get("name")
        example = c.get("example_command", "")
        if not name or not example.strip():
            continue
        if args.dry_run:
            staged.append({"name": name, "would_stage": True, "why": c.get("why", "")})
            continue
        cmd = [str(HERE / "garden-tool"), "--name", name,
               "--backend", args.backend]
        if c.get("runtime_hint"):
            cmd += ["--runtime", c["runtime_hint"]]
        if args.model:
            cmd += ["--model", args.model]
        r = subprocess.run(cmd, input=example, capture_output=True, text=True)
        ok = r.returncode == 0
        staged.append({"name": name, "staged": ok,
                       "detail": (r.stdout or r.stderr).strip().splitlines()[-1:] })

    if not args.dry_run:
        cur = store / "tools" / ".mined.log"
        cur.parent.mkdir(parents=True, exist_ok=True)
        with cur.open("a") as fh:
            for t in traces:
                fh.write(t + "\n")

    print(json.dumps({"dry_run": args.dry_run, "mined_traces": len(traces),
                      "candidates": len(result.get("candidates", [])),
                      "new": len(candidates), "staged": staged,
                      "report": result.get("report", "")}, indent=2))
    if staged and not args.dry_run:
        log("staged mined candidates — review with garden-tool-gate")
    return 0


if __name__ == "__main__":
    sys.exit(main())
