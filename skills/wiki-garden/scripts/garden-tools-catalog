#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""(Re)generate the Wiki Garden tools catalog from <store>/tools/*/TOOL.md.

Writes a Runme-compatible <store>/tools/CATALOG.md and a discoverable
`wiki-garden-tools` skill (~/.claude/skills/wiki-garden-tools/SKILL.md) so an
agent finds and reuses installed tools instead of rewriting them. Run manually,
or let garden-tool-gate regenerate it on accept.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _garden
from _garden import log

if __name__ == "__main__":
    store = _garden.resolve_store(HERE)
    out = _garden.write_tools_catalog(store)
    log(f"store: {store}")
    print(json.dumps(out, indent=2))
    if out["count"]:
        log(f"catalog: {store/'tools'/'CATALOG.md'}  skill: ~/.claude/skills/wiki-garden-tools")
    else:
        log("no tools yet — catalog skill removed if present")
